# Copy to .env.local. Leave LLM keys empty to run the offline scripted engine.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional xAI (Grok) fallback/alternative (set LLM_PROVIDER=grok to prefer Grok when both keys exist)
XAI_API_KEY=
GROK_MODEL=grok-4
LLM_PROVIDER=

# Supabase Auth & Database (optional: leave empty to run demo mode without auth)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
