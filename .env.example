# Copy to .env.local. Leave XAI_API_KEY empty to run the scripted "mock" agent engine.
XAI_API_KEY=
# Model name for the xAI (Grok) chat-completions API — set whatever your account has.
GROK_MODEL=grok-4

# Supabase Auth & Database (optional: leave empty to run demo mode without auth)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
